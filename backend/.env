# =============================================================================
# Construction Safety AI — Environment Variables Template
# Copy file này thành .env và điền giá trị thực
# =============================================================================

# ── Project ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS — Danh sách origins được phép (phân cách bằng dấu phẩy) ─────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# ── AI / Model ────────────────────────────────────────────────────────────────
MODEL_PATH=ppe_5classes_model_results/weights/best.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DEVICE=cpu                      # cpu | cuda | mps

# Database (Chạy PostgreSQL cục bộ trên cổng 5432)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/construction_safety

# ── MinIO S3 Storage ─────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=construction-safety-evidence
MINIO_USE_SSL=False

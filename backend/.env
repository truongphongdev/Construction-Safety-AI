# =============================================================================
# Construction Safety AI — Environment Variables Template
# Copy file này thành .env và điền giá trị thực
# =============================================================================

# ── Project ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS — Danh sách origins được phép (phân cách bằng dấu phẩy) ─────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── AI / Model ────────────────────────────────────────────────────────────────
MODEL_PATH=ai/weights/best.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
DEVICE=cpu                       # cpu | cuda | mps

# Database
DATABASE_URL=postgresql://postgres:123456@localhost:5432/construction-safety


